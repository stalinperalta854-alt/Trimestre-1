CODIGO SENSOR ULTRASONICO 
#include "BluetoothSerial.h"

#if !defined(CONFIG_BT_ENABLED) || !defined(CONFIG_BLUEDROID_ENABLED)
#error "Bluetooth no está habilitado. Usa un ESP32 con Bluetooth clásico."
#endif

BluetoothSerial SerialBT;

// ---------- Pines ----------
const int PIN_TRIG = 5;
const int PIN_ECHO = 18;
const int PIN_LED  = 2;

// ---------- Configuración ----------
const char* NOMBRE_BT       = "ESP32_Distancia";  // Nombre que aparece en la app
const unsigned long PERIODO = 300;                // ms entre lecturas
float umbral = 20.0;                              // cm (lo cambia el deslizador)

unsigned long ultimoEnvio = 0;
String bufferEntrada = "";

// Mide la distancia en cm. Devuelve -1 si no hay eco.
float medirDistancia() {
  digitalWrite(PIN_TRIG, LOW);
  delayMicroseconds(2);
  digitalWrite(PIN_TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(PIN_TRIG, LOW);

  // Timeout de 30 ms (~5 m) para no bloquear el programa
  unsigned long duracion = pulseIn(PIN_ECHO, HIGH, 30000);
  if (duracion == 0) return -1;

  return duracion * 0.0343 / 2.0;  // velocidad del sonido: 343 m/s
}

// Procesa los mensajes que llegan desde la app
void procesarComando(String cmd) {
  cmd.trim();
  if (cmd.length() == 0) return;

  if (cmd.charAt(0) == 'U' || cmd.charAt(0) == 'u') {
    float nuevo = cmd.substring(1).toFloat();
    if (nuevo > 0 && nuevo <= 400) {
      umbral = nuevo;
      Serial.print("Nuevo umbral: ");
      Serial.println(umbral);
    }
  }
}

void leerBluetooth() {
  while (SerialBT.available()) {
    char c = SerialBT.read();
    if (c == '\n') {
      procesarComando(bufferEntrada);
      bufferEntrada = "";
    } else if (c != '\r') {
      bufferEntrada += c;
    }
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);
  pinMode(PIN_LED, OUTPUT);

  SerialBT.begin(NOMBRE_BT);
  Serial.println("Bluetooth listo. Busca: ESP32_Distancia");
}

void loop() {
  leerBluetooth();

  if (millis() - ultimoEnvio >= PERIODO) {
    ultimoEnvio = millis();

    float d = medirDistancia();

    // LED encendido si el objeto está CERCA (por debajo del umbral)
    digitalWrite(PIN_LED, (d > 0 && d <= umbral) ? HIGH : LOW);

    // Enviar a la app solo si hay un cliente conectado
    if (SerialBT.hasClient()) {
      if (d < 0) SerialBT.println("-1");
      else       SerialBT.println(d, 1);  // 1 decimal, ej: 23.4
    }

    // Monitor serie (para depurar)
    Serial.print("Distancia: ");
    Serial.print(d, 1);
    Serial.print(" cm | Umbral: ");
    Serial.println(umbral);
  }
}
