                    {u.active ? 'Activo' : 'Suspendido'}
                  </button>
                )}
              </div>
            ))}
          </div>
        )}
      </div>

      {/* MODAL AGREGAR / EDITAR PRODUCTO */}
      {productModalOpen && (
        <div className="absolute inset-0 bg-black/90 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="w-full max-h-[88vh] overflow-y-auto bg-[#0F172A] border border-slate-700 rounded-3xl p-5 shadow-2xl">
            <div className="flex items-center justify-between pb-3 border-b border-slate-800">
              <h3 className="font-extrabold text-sm text-white">
                {editingProduct ? 'Editar Producto' : 'Nuevo Producto Mecatrónico'}
              </h3>
              <button onClick={() => setProductModalOpen(false)} className="text-slate-400 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleSaveProduct} className="mt-4 space-y-3 text-xs">
              {/* Vista previa y carga de imagen */}
              <div className="flex items-center gap-3 bg-[#05080F] p-3 rounded-2xl border border-slate-800">
                <img
                  src={prodImagePreview}
                  alt="Vista previa"
                  className="w-16 h-16 rounded-xl object-cover border border-slate-700 shrink-0"
                />
                <div className="flex-1 space-y-1.5">
                  <label className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#0088FF]/20 border border-[#0088FF]/40 text-[#38BDF8] font-bold cursor-pointer hover:bg-[#0088FF] hover:text-white transition-colors">
                    <Upload className="w-3.5 h-3.5" /> Subir fotografía
                    <input type="file" accept="image/*" onChange={handleImageFileUpload} className="hidden" />
                  </label>
                  <input
                    type="text"
                    name="imageUrl"
                    value={prodImagePreview}
                    onChange={(e) => setProdImagePreview(e.target.value)}
                    placeholder="O pega URL / DataURI de imagen"
                    className="w-full bg-[#0F172A] border border-slate-700 rounded-lg px-2 py-1 text-[10px] text-slate-300"
                  />
                </div>
              </div>

              <div>
                <label className="block text-slate-400 mb-1">Nombre del artículo *</label>
                <input
                  type="text"
                  name="name"
                  required
                  defaultValue={editingProduct?.name || ''}
                  placeholder="Ej. Servomotor Digital MG996R"
                  className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                />
              </div>

              <div className="grid grid-cols-2 gap-2">
                <div>
                  <label className="block text-slate-400 mb-1">Categoría *</label>
                  <select
                    name="category"
                    defaultValue={editingProduct?.category || categories[0]?.name}
                    className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                  >
                    {categories.map((c) => (
                      <option key={c.id} value={c.name}>
                        {c.name}
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="block text-slate-400 mb-1">Precio USD ($) *</label>
                  <input
                    type="number"
                    step="0.01"
                    min="0.01"
                    name="price"
                    required
                    defaultValue={editingProduct?.price || ''}
                    placeholder="12.50"
                    className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-2">
                <div>
                  <label className="block text-slate-400 mb-1">Disponibilidad (Stock) *</label>
                  <input
                    type="number"
                    min="0"
                    name="stock"
                    required
                    defaultValue={editingProduct?.stock ?? 15}
                    className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                  />
                </div>
                <div>
                  <label className="block text-slate-400 mb-1">Promoción (% Descuento)</label>
                  <input
                    type="number"
                    min="0"
                    max="90"
                    name="discountPercent"
                    defaultValue={editingProduct?.discountPercent ?? 0}
                    className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                  />
                </div>
              </div>

              <div>
                <label className="block text-slate-400 mb-1">Descripción corta *</label>
                <input
                  type="text"
                  name="shortDesc"
                  required
                  defaultValue={editingProduct?.shortDesc || ''}
                  placeholder="Resumen breve para la tarjeta del catálogo"
                  className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                />
              </div>

              <div>
                <label className="block text-slate-400 mb-1">Descripción completa *</label>
                <textarea
                  name="fullDesc"
                  rows="2"
                  required
                  defaultValue={editingProduct?.fullDesc || ''}
                  placeholder="Detalles técnicos y aplicaciones en mecatrónica..."
                  className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                />
              </div>

              <div>
                <label className="block text-slate-400 mb-1">Características técnicas (una por línea)</label>
                <textarea
                  name="features"
                  rows="3"
                  defaultValue={editingProduct?.features?.join('\n') || ''}
                  placeholder={'Voltaje: 5V - 12V DC\nInterfaz: I2C / SPI\nTorque: 10 kg·cm'}
                  className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                />
              </div>

              <div className="flex items-center gap-4 pt-1">
                <label className="flex items-center gap-2 text-slate-300 cursor-pointer">
                  <input
                    type="checkbox"
                    name="isFeatured"
                    defaultChecked={editingProduct ? editingProduct.isFeatured : true}
                    className="accent-[#0088FF] w-4 h-4"
                  />
                  Destacado
                </label>
                <label className="flex items-center gap-2 text-slate-300 cursor-pointer">
                  <input
                    type="checkbox"
                    name="isNew"
                    defaultChecked={editingProduct ? editingProduct.isNew : true}
                    className="accent-[#0088FF] w-4 h-4"
                  />
                  Producto Nuevo
                </label>
              </div>

              <button
                type="submit"
                className="w-full bg-gradient-to-r from-[#0088FF] to-[#0EA5E9] text-white font-bold py-3 rounded-xl mt-2 shadow-lg shadow-[#0088FF]/25"
              >
                {editingProduct ? 'Guardar Cambios' : 'Publicar Producto'}
              </button>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}

// ============================================================================
// PANTALLA 4: EXPERIENCIA COMPLETA DEL CLIENTE (TIENDA + BARRA INFERIOR)
// ============================================================================
function ClientStorefront({
  products,
  setProducts,
  categories,
  banners,
  announcements,
  cart,
  setCart,
  addToCart,
  updateCartQty,
  removeFromCart,
  favorites,
  toggleFavorite,
  orders,
  setOrders,
  getFinalPrice,
  clientTab,
  setClientTab,
  selectedProduct,
  setSelectedProduct,
  detailQty,
  setDetailQty,
  lastOrderReceipt,
  setLastOrderReceipt,
  onSwitchRole,
  showToast,
}) {
  const [searchQuery, setSearchQuery] = useState('');
  const [activeCategoryFilter, setActiveCategoryFilter] = useState('Todos');
  const [customerName, setCustomerName] = useState('Carlos Mendoza');
  const [customerEmail, setCustomerEmail] = useState('carlos.meca@correo.com');
  const [customerNote, setCustomerNote] = useState('');

  const activeAnnouncements = announcements.filter((a) => a.active);
  const activeBanners = banners.filter((b) => b.active);

  // Productos enriquecidos en el carrito
  const cartItemsDetailed = useMemo(() => {
    return cart
      .map((item) => {
        const prod = products.find((p) => p.id === item.id);
        if (!prod) return null;
        const unitPrice = getFinalPrice(prod);
        return {
          ...prod,
          quantity: item.quantity,
          unitPrice,
          lineTotal: Number((unitPrice * item.quantity).toFixed(2)),
        };
      })
      .filter(Boolean);
  }, [cart, products]);

  const cartCount = cartItemsDetailed.reduce((acc, item) => acc + item.quantity, 0);
  const cartSubtotal = cartItemsDetailed.reduce((acc, item) => acc + item.lineTotal, 0);
  const cartTotal = cartSubtotal;

  // Filtrado por búsqueda y categoría
  const filteredProducts = useMemo(() => {
    return products.filter((p) => {
      const q = searchQuery.trim().toLowerCase();
      const matchesSearch =
        !q ||
        p.name.toLowerCase().includes(q) ||
        p.shortDesc.toLowerCase().includes(q) ||
        p.category.toLowerCase().includes(q);
      const matchesCat =
        activeCategoryFilter === 'Todos' || p.category === activeCategoryFilter;
      return matchesSearch && matchesCat;
    });
  }, [products, searchQuery, activeCategoryFilter]);

  const promoProducts = products.filter((p) => p.discountPercent > 0);
  const featuredProducts = products.filter((p) => p.isFeatured);
  const newProducts = products.filter((p) => p.isNew);

  const openProductDetail = (product) => {
    setSelectedProduct(product);
    setDetailQty(1);
  };

  // Confirmación real de pedido -> descuenta stock y lo envía al Panel de Administrador
  const handleConfirmOrder = (e) => {
    e.preventDefault();
    if (cartItemsDetailed.length === 0) return;

    const newOrder = {
      id: `PED-${Math.floor(1000 + Math.random() * 9000)}`,
      customerName: customerName.trim() || 'Cliente MP',
      customerEmail: customerEmail.trim() || 'cliente@mpmecatronica.com',
      note: customerNote.trim(),
      items: cartItemsDetailed.map((i) => ({
        id: i.id,
        name: i.name,
        price: i.unitPrice,
        quantity: i.quantity,
      })),
      total: Number(cartTotal.toFixed(2)),
      status: 'Pendiente',
      date: new Date().toLocaleString('es-EC', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      }),
    };

    // Actualizar stock en inventario central
    setProducts((prev) =>
      prev.map((prod) => {
        const bought = cartItemsDetailed.find((c) => c.id === prod.id);
        if (!bought) return prod;
        return { ...prod, stock: Math.max(0, prod.stock - bought.quantity) };
      })
    );

    setOrders((prev) => [newOrder, ...prev]);
    setCart([]);
    setCustomerNote('');
    setLastOrderReceipt(newOrder);
    showToast(`¡Pedido ${newOrder.id} confirmado con éxito!`, 'success');
  };

  // ==========================================================================
  // SUBVISTA: DETALLE DE PRODUCTO
  // ==========================================================================
  if (selectedProduct) {
    // Sincronizar en vivo por si el admin editó este producto
    const liveProd = products.find((p) => p.id === selectedProduct.id) || selectedProduct;
    const finalPrice = getFinalPrice(liveProd);
    const isFav = favorites.includes(liveProd.id);

    return (
      <div className="min-h-full bg-[#05080F] flex flex-col pb-24">
        {/* Barra superior flotante */}
        <div className="sticky top-0 z-30 px-4 py-3 bg-[#05080F]/90 backdrop-blur-md border-b border-slate-800/80 flex items-center justify-between">
          <button
            onClick={() => setSelectedProduct(null)}
            className="p-2 rounded-xl bg-[#0F172A] border border-slate-800 text-slate-200 hover:border-[#0088FF]"
          >
            <ArrowLeft className="w-4 h-4" />
          </button>
          <span className="text-xs font-bold text-slate-300 truncate max-w-[200px]">
            Detalle Técnico
          </span>
          <button
            onClick={() => toggleFavorite(liveProd.id)}
            className={`p-2 rounded-xl border ${
              isFav
                ? 'bg-rose-500/15 border-rose-500/40 text-rose-400'
                : 'bg-[#0F172A] border-slate-800 text-slate-400'
            }`}
          >
            <Heart className={`w-4 h-4 ${isFav ? 'fill-rose-400' : ''}`} />
          </button>
        </div>

        {/* Imagen Grande */}
        <div className="relative w-full h-60 bg-black border-b border-slate-800 overflow-hidden">
          <img src={liveProd.image} alt={liveProd.name} className="w-full h-full object-cover" />
          <div className="absolute top-3 left-3 flex gap-1.5">
            <span className="px-2.5 py-1 rounded-lg bg-black/80 border border-slate-700 text-[#38BDF8] text-[10px] font-bold">
              {liveProd.category}
            </span>
            {liveProd.discountPercent > 0 && (
              <span className="px-2.5 py-1 rounded-lg bg-emerald-500 text-black text-[10px] font-black">
                -{liveProd.discountPercent}% OFF
              </span>
            )}
          </div>
        </div>

        {/* Información del Producto */}
        <div className="p-5 space-y-4">
          <div>
            <h1 className="text-lg font-extrabold text-white leading-snug">{liveProd.name}</h1>
            <div className="mt-2 flex items-baseline gap-2.5">
              <span className="text-2xl font-black text-[#38BDF8]">${finalPrice.toFixed(2)}</span>
              {liveProd.discountPercent > 0 && (
                <span className="text-sm text-slate-500 line-through">${liveProd.price.toFixed(2)}</span>
              )}
            </div>
          </div>

          {/* Disponibilidad Exacta */}
          <div className="flex items-center justify-between p-3 rounded-2xl bg-[#0F172A] border border-slate-800 text-xs">
            <span className="text-slate-400">Disponibilidad en almacén:</span>
            {liveProd.stock > 0 ? (
              <span className="font-bold text-emerald-400 flex items-center gap-1.5">
                <span className="w-2 h-2 rounded-full bg-emerald-400" />
                En stock ({liveProd.stock} unidades)
              </span>
            ) : (
              <span className="font-bold text-rose-400">Agotado</span>
            )}
          </div>

          {/* Descripción Completa */}
          <div>
            <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-300 mb-1.5">
              Descripción completa
            </h3>
            <p className="text-xs text-slate-400 leading-relaxed">{liveProd.fullDesc}</p>
          </div>

          {/* Características Técnicas */}
          <div>
            <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-300 mb-2">
              Características técnicas
            </h3>
            <ul className="space-y-1.5">
              {(liveProd.features || []).map((feat, index) => (
                <li
                  key={index}
                  className="flex items-start gap-2 text-xs text-slate-300 bg-[#0F172A]/70 border border-slate-800/80 px-3 py-2 rounded-xl"
                >
                  <CheckCircle2 className="w-4 h-4 text-[#0088FF] shrink-0 mt-0.5" />
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Selector de Cantidad y Botón Agregar */}
          <div className="pt-2 flex items-center gap-3">
            <div className="flex items-center bg-[#0F172A] border border-slate-700 rounded-2xl p-1">
              <button
                type="button"
                onClick={() => setDetailQty((q) => Math.max(1, q - 1))}
                className="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-base"
              >
                -
              </button>
              <span className="w-10 text-center text-sm font-extrabold text-white">{detailQty}</span>
              <button
                type="button"
                onClick={() => setDetailQty((q) => Math.min(Math.max(1, liveProd.stock), q + 1))}
                className="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-base"
              >
                +
              </button>
