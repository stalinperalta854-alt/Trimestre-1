// PANTALLA 3A: INICIO DE SESIÓN, REGISTRO Y RECUPERACIÓN DE ADMINISTRADOR
// ============================================================================
function AdminLoginScreen({ users, setUsers, onBack, onSuccess, showToast }) {
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [showPass, setShowPass] = useState(false);

  // Modales de Registro y Recuperación
  const [showRegisterModal, setShowRegisterModal] = useState(false);
  const [showForgotModal, setShowForgotModal] = useState(false);

  // Estados de registro
  const [regName, setRegName] = useState('');
  const [regUser, setRegUser] = useState('');
  const [regEmail, setRegEmail] = useState('');
  const [regPass, setRegPass] = useState('');

  // Estados de recuperación
  const [forgotEmail, setForgotEmail] = useState('');
  const [newResetPass, setNewResetPass] = useState('');

  const handleLogin = (e) => {
    e.preventDefault();
    const cleanUser = username.trim().toLowerCase();
    const hashedInput = hashCredential(password);

    const foundAdmin = users.find(
      (u) =>
        u.role === 'admin' &&
        (u.username.toLowerCase() === cleanUser || u.email.toLowerCase() === cleanUser) &&
        u.passwordHash === hashedInput
    );

    if (!foundAdmin) {
      showToast('Usuario o contraseña de administrador incorrectos.', 'error');
      return;
    }
    if (!foundAdmin.active) {
      showToast('Esta cuenta de administrador está deshabilitada.', 'error');
      return;
    }
    onSuccess(foundAdmin);
  };

  const handleRegisterAdmin = (e) => {
    e.preventDefault();
    if (regPass.length < 6) {
      showToast('La contraseña debe tener al menos 6 caracteres.', 'warning');
      return;
    }
    const exists = users.some(
      (u) => u.username.toLowerCase() === regUser.trim().toLowerCase() || u.email.toLowerCase() === regEmail.trim().toLowerCase()
    );
    if (exists) {
      showToast('El usuario o correo ya está registrado.', 'error');
      return;
    }
    const newAdmin = {
      id: `usr-admin-${Date.now()}`,
      username: regUser.trim(),
      name: regName.trim(),
      email: regEmail.trim(),
      role: 'admin',
      passwordHash: hashCredential(regPass),
      active: true,
      createdAt: new Date().toISOString().slice(0, 10),
    };
    setUsers((prev) => [...prev, newAdmin]);
    setShowRegisterModal(false);
    setUsername(newAdmin.username);
    setPassword('');
    setRegName('');
    setRegUser('');
    setRegEmail('');
    setRegPass('');
    showToast('Administrador registrado con contraseña cifrada.', 'success');
  };

  const handleResetPassword = (e) => {
    e.preventDefault();
    const target = users.find(
      (u) => u.role === 'admin' && (u.email.toLowerCase() === forgotEmail.trim().toLowerCase() || u.username.toLowerCase() === forgotEmail.trim().toLowerCase())
    );
    if (!target) {
      showToast('No se encontró un administrador con ese usuario/correo.', 'error');
      return;
    }
    if (newResetPass.length < 6) {
      showToast('La nueva contraseña debe tener al menos 6 caracteres.', 'warning');
      return;
    }
    setUsers((prev) =>
      prev.map((u) => (u.id === target.id ? { ...u, passwordHash: hashCredential(newResetPass) } : u))
    );
    setShowForgotModal(false);
    setForgotEmail('');
    setNewResetPass('');
    showToast('Contraseña actualizada correctamente. Ya puedes iniciar sesión.', 'success');
  };

  return (
    <div className="min-h-full bg-[#05080F] p-6 flex flex-col justify-between relative">
      <div>
        <button
          onClick={onBack}
          className="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-[#38BDF8] transition-colors py-1.5 px-3 rounded-xl bg-[#0F172A] border border-slate-800"
        >
          <ArrowLeft className="w-4 h-4" /> Cambiar perfil
        </button>

        <div className="flex flex-col items-center text-center mt-5">
          <MPLogo size={84} />
          <h2 className="mt-4 text-xl font-extrabold text-white">Acceso Administrativo</h2>
          <p className="text-xs text-slate-400 mt-1">
            Panel de control seguro de MP Mecatrónica
          </p>
        </div>

        <form onSubmit={handleLogin} className="mt-6 space-y-4">
          <div>
            <label className="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">
              Usuario o Correo
            </label>
            <div className="relative">
              <User className="w-4 h-4 text-slate-500 absolute left-3.5 top-3.5" />
              <input
                type="text"
                value={username}
                onChange={(e) => setUsername(e.target.value)}
                placeholder="Ej. admin"
                required
                className="w-full bg-[#0F172A] border border-slate-800 focus:border-[#0088FF] rounded-2xl py-3 pl-10 pr-4 text-sm text-white placeholder-slate-500 focus:outline-none transition-colors"
              />
            </div>
          </div>

          <div>
            <label className="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">
              Contraseña
            </label>
            <div className="relative">
              <Lock className="w-4 h-4 text-slate-500 absolute left-3.5 top-3.5" />
              <input
                type={showPass ? 'text' : 'password'}
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                placeholder="••••••••"
                required
                className="w-full bg-[#0F172A] border border-slate-800 focus:border-[#0088FF] rounded-2xl py-3 pl-10 pr-11 text-sm text-white placeholder-slate-500 focus:outline-none transition-colors"
              />
              <button
                type="button"
                onClick={() => setShowPass(!showPass)}
                className="absolute right-3.5 top-3 text-slate-400 hover:text-[#38BDF8] p-0.5"
                title={showPass ? 'Ocultar contraseña' : 'Mostrar contraseña'}
              >
                {showPass ? <EyeOff className="w-4 h-4" /> : <Eye className="w-4 h-4" />}
              </button>
            </div>
          </div>

          <div className="flex items-center justify-between pt-1">
            <button
              type="button"
              onClick={() => setShowForgotModal(true)}
              className="text-xs font-medium text-[#38BDF8] hover:underline"
            >
              ¿Olvidaste tu contraseña?
            </button>
          </div>

          <button
            type="submit"
            className="w-full bg-gradient-to-r from-[#0088FF] to-[#0EA5E9] hover:brightness-110 text-white font-bold py-3.5 rounded-2xl shadow-lg shadow-[#0088FF]/25 transition-all text-sm"
          >
            Iniciar sesión
          </button>

          <button
            type="button"
            onClick={() => setShowRegisterModal(true)}
            className="w-full bg-[#0F172A] hover:bg-slate-800 border border-slate-700 text-slate-200 font-semibold py-3 rounded-2xl transition-colors text-xs"
          >
            Registrarse como nuevo Administrador
          </button>
        </form>
      </div>

      {/* Nota sutil de demostración rápida */}
      <div className="mt-6 p-3.5 rounded-2xl bg-[#0F172A]/80 border border-slate-800/90 flex items-center justify-between gap-2">
        <div className="text-[11px] text-slate-400">
          <span className="text-[#38BDF8] font-bold block">Acceso Demo Rápido:</span>
          Usuario: <code className="text-slate-200">admin</code> • Clave: <code className="text-slate-200">admin123</code>
        </div>
        <button
          type="button"
          onClick={() => {
            setUsername('admin');
            setPassword('admin123');
          }}
          className="px-3 py-1.5 rounded-xl bg-[#0088FF]/15 border border-[#0088FF]/40 text-[#38BDF8] text-[11px] font-bold hover:bg-[#0088FF] hover:text-white transition-colors shrink-0"
        >
          Autocompletar
        </button>
      </div>

      {/* MODAL: REGISTRAR NUEVO ADMINISTRADOR */}
      {showRegisterModal && (
        <div className="absolute inset-0 bg-black/85 backdrop-blur-sm z-50 flex items-center justify-center p-5">
          <div className="w-full bg-[#0F172A] border border-slate-700 rounded-3xl p-5 shadow-2xl">
            <div className="flex items-center justify-between pb-3 border-b border-slate-800">
              <h3 className="font-bold text-sm text-white flex items-center gap-2">
                <Shield className="w-4 h-4 text-[#0088FF]" /> Registrar Administrador
              </h3>
              <button onClick={() => setShowRegisterModal(false)} className="text-slate-400 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>
            <form onSubmit={handleRegisterAdmin} className="mt-4 space-y-3 text-xs">
              <div>
                <label className="block text-slate-400 mb-1">Nombre completo</label>
                <input
                  type="text"
                  required
                  value={regName}
                  onChange={(e) => setRegName(e.target.value)}
                  placeholder="Ej. Ing. Laura Gómez"
                  className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                />
              </div>
              <div>
                <label className="block text-slate-400 mb-1">Nombre de usuario</label>
                <input
                  type="text"
                  required
                  value={regUser}
                  onChange={(e) => setRegUser(e.target.value)}
                  placeholder="Ej. laura.admin"
                  className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                />
              </div>
              <div>
                <label className="block text-slate-400 mb-1">Correo electrónico</label>
                <input
                  type="email"
                  required
                  value={regEmail}
                  onChange={(e) => setRegEmail(e.target.value)}
                  placeholder="laura@mpmecatronica.com"
                  className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                />
              </div>
              <div>
                <label className="block text-slate-400 mb-1">Contraseña (mín. 6 caracteres)</label>
                <input
                  type="password"
                  required
                  value={regPass}
                  onChange={(e) => setRegPass(e.target.value)}
                  placeholder="••••••••"
                  className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                />
              </div>
              <button
                type="submit"
                className="w-full bg-[#0088FF] hover:bg-[#0EA5E9] text-white font-bold py-3 rounded-xl mt-2"
              >
                Crear Cuenta Segura
              </button>
            </form>
          </div>
        </div>
      )}

      {/* MODAL: RECUPERAR CONTRASEÑA */}
      {showForgotModal && (
        <div className="absolute inset-0 bg-black/85 backdrop-blur-sm z-50 flex items-center justify-center p-5">
          <div className="w-full bg-[#0F172A] border border-slate-700 rounded-3xl p-5 shadow-2xl">
            <div className="flex items-center justify-between pb-3 border-b border-slate-800">
              <h3 className="font-bold text-sm text-white flex items-center gap-2">
                <Lock className="w-4 h-4 text-[#38BDF8]" /> Recuperar Contraseña
              </h3>
              <button onClick={() => setShowForgotModal(false)} className="text-slate-400 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>
            <form onSubmit={handleResetPassword} className="mt-4 space-y-3 text-xs">
              <p className="text-slate-400">
                Ingresa tu usuario o correo de administrador registrado para establecer una nueva clave cifrada.
              </p>
              <div>
                <label className="block text-slate-400 mb-1">Usuario o Correo</label>
                <input
                  type="text"
                  required
                  value={forgotEmail}
                  onChange={(e) => setForgotEmail(e.target.value)}
                  placeholder="admin o admin@mpmecatronica.com"
                  className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                />
              </div>
              <div>
                <label className="block text-slate-400 mb-1">Nueva contraseña</label>
                <input
                  type="password"
                  required
                  value={newResetPass}
                  onChange={(e) => setNewResetPass(e.target.value)}
                  placeholder="Nueva clave segura"
                  className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-white"
                />
              </div>
              <button
                type="submit"
                className="w-full bg-[#0088FF] hover:bg-[#0EA5E9] text-white font-bold py-3 rounded-xl mt-2"
              >
                Restablecer Contraseña
              </button>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}

// ============================================================================
// PANTALLA 3B: PANEL DE ADMINISTRACIÓN COMPLETO (CRUD EN TIEMPO REAL)
// ============================================================================
function AdminDashboard({
  admin,
  products,
  setProducts,
  categories,
  setCategories,
  banners,
  setBanners,
  announcements,
  setAnnouncements,
  orders,
  setOrders,
  users,
  setUsers,
  onLogout,
  onPreviewStore,
  showToast,
}) {
  const [activeTab, setActiveTab] = useState('stats'); // stats | products | categories | marketing | orders | users

  // Modales CRUD Productos
  const [productModalOpen, setProductModalOpen] = useState(false);
  const [editingProduct, setEditingProduct] = useState(null);
  const [prodImagePreview, setProdImagePreview] = useState('');

  // Estados CRUD Categorías
  const [newCatName, setNewCatName] = useState('');
  const [newCatDesc, setNewCatDesc] = useState('');
  const [editingCatId, setEditingCatId] = useState(null);

  // Estados Marketing (Banners y Anuncios)
  const [bannerTitle, setBannerTitle] = useState('');
  const [bannerSubtitle, setBannerSubtitle] = useState('');
  const [bannerTag, setBannerTag] = useState('OFERTA ESPECIAL');
  const [newAnnouncementText, setNewAnnouncementText] = useState('');

  // Estadísticas calculadas en vivo
  const stats = useMemo(() => {
    const totalRevenue = orders.reduce((sum, o) => sum + o.total, 0);
    const lowStockCount = products.filter((p) => p.stock <= 10).length;
    const pendingOrders = orders.filter((o) => o.status === 'Pendiente' || o.status === 'En preparación').length;
    return {
      totalProducts: products.length,
      totalOrders: orders.length,
      totalRevenue,
      lowStockCount,
      pendingOrders,
    };
  }, [products, orders]);

  // Subida de fotografía mediante FileReader / Base64
  const handleImageFileUpload = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onloadend = () => {
      setProdImagePreview(reader.result);
    };
    reader.readAsDataURL(file);
  };

  const openCreateProduct = () => {
    setEditingProduct(null);
    setProdImagePreview(createTechProductArt('NUEVO COMPONENTE', 'MP-TECH', '#0088FF', 'chip'));
    setProductModalOpen(true);
  };

  const openEditProduct = (prod) => {
    setEditingProduct(prod);
    setProdImagePreview(prod.image);
    setProductModalOpen(true);
  };

  const handleSaveProduct = (e) => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const featuresRaw = fd.get('features') || '';
    const parsedFeatures = featuresRaw
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean);

    const payload = {
      id: editingProduct ? editingProduct.id : `prod-${Date.now()}`,
      name: fd.get('name').trim(),
      category: fd.get('category'),
      price: Math.max(0.01, parseFloat(fd.get('price')) || 0),
      discountPercent: Math.min(90, Math.max(0, parseInt(fd.get('discountPercent'), 10) || 0)),
      stock: Math.max(0, parseInt(fd.get('stock'), 10) || 0),
      shortDesc: fd.get('shortDesc').trim(),
      fullDesc: fd.get('fullDesc').trim(),
      features: parsedFeatures.length > 0 ? parsedFeatures : ['Garantía técnica MP Mecatrónica', 'Alta eficiencia energética'],
      image: prodImagePreview || fd.get('imageUrl') || createTechProductArt(fd.get('name'), 'MP', '#0088FF', 'chip'),
      isFeatured: fd.get('isFeatured') === 'on',
      isNew: fd.get('isNew') === 'on',
    };

    if (editingProduct) {
      setProducts((prev) => prev.map((p) => (p.id === editingProduct.id ? payload : p)));
      showToast('Producto actualizado y sincronizado en la tienda.', 'success');
    } else {
      setProducts((prev) => [payload, ...prev]);
      showToast('Nuevo producto publicado en el catálogo.', 'success');
    }
    setProductModalOpen(false);
  };

  const handleDeleteProduct = (id) => {
    setProducts((prev) => prev.filter((p) => p.id !== id));
    showToast('Producto eliminado del inventario.', 'info');
  };

  // CRUD Categorías
  const handleSaveCategory = (e) => {
    e.preventDefault();
    if (!newCatName.trim()) return;
    if (editingCatId) {
      const oldCat = categories.find((c) => c.id === editingCatId);
      setCategories((prev) =>
        prev.map((c) => (c.id === editingCatId ? { ...c, name: newCatName.trim(), description: newCatDesc.trim() } : c))
      );
      if (oldCat && oldCat.name !== newCatName.trim()) {
        setProducts((prev) =>
          prev.map((p) => (p.category === oldCat.name ? { ...p, category: newCatName.trim() } : p))
        );
      }
      setEditingCatId(null);
      showToast('Categoría actualizada.', 'success');
    } else {
      setCategories((prev) => [
        ...prev,
        { id: `cat-${Date.now()}`, name: newCatName.trim(), icon: 'Cpu', description: newCatDesc.trim() || 'Artículos especializados.' },
      ]);
      showToast('Nueva categoría creada.', 'success');
    }
    setNewCatName('');
    setNewCatDesc('');
  };

  const handleDeleteCategory = (cat) => {
    setCategories((prev) => prev.filter((c) => c.id !== cat.id));
    showToast(`Categoría "${cat.name}" eliminada.`, 'info');
  };

  // Marketing: Banners y Anuncios
  const handleCreateBanner = (e) => {
    e.preventDefault();
    if (!bannerTitle.trim()) return;
    const newBan = {
      id: `ban-${Date.now()}`,
      tag: bannerTag.trim() || 'DESTACADO',
      title: bannerTitle.trim(),
      subtitle: bannerSubtitle.trim() || 'Tecnología y precisión para tus proyectos.',
      ctaText: 'Explorar ahora',
      filterTarget: 'PROMO',
      active: true,
    };
    setBanners((prev) => [newBan, ...prev]);
    setBannerTitle('');
    setBannerSubtitle('');
    showToast('Banner publicado en la tienda.', 'success');
  };

  const handleCreateAnnouncement = (e) => {
    e.preventDefault();
    if (!newAnnouncementText.trim()) return;
    setAnnouncements((prev) => [{ id: `ann-${Date.now()}`, text: newAnnouncementText.trim(), active: true }, ...prev]);
    setNewAnnouncementText('');
    showToast('Anuncio superior publicado.', 'success');
  };

  const navTabs = [
    { id: 'stats', label: 'Resumen', icon: TrendingUp },
    { id: 'products', label: 'Productos', icon: Package },
    { id: 'categories', label: 'Categorías', icon: Grid },
    { id: 'marketing', label: 'Banners', icon: Megaphone },
    { id: 'orders', label: 'Pedidos', icon: ShoppingCart },
    { id: 'users', label: 'Usuarios', icon: Users },
  ];

  return (
    <div className="min-h-full bg-[#05080F] flex flex-col pb-8">
      {/* Encabezado Superior Admin */}
      <div className="bg-[#0B111E] border-b border-slate-800/90 px-4 py-3 sticky top-0 z-30 flex items-center justify-between">
        <div className="flex items-center gap-2.5">
          <MPLogo size={38} glow={false} />
          <div>
            <h2 className="text-xs font-extrabold text-white tracking-wide">PANEL ADMIN MP</h2>
            <p className="text-[10px] text-[#38BDF8] flex items-center gap-1">
              <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping" /> {admin.name}
            </p>
          </div>
        </div>
        <div className="flex items-center gap-1.5">
          <button
            onClick={onPreviewStore}
            className="px-2.5 py-1.5 rounded-xl bg-[#0088FF]/15 border border-[#0088FF]/40 text-[#38BDF8] text-[10px] font-bold hover:bg-[#0088FF] hover:text-white transition-colors"
            title="Ver tienda como cliente"
          >
            Ver Tienda
          </button>
          <button
            onClick={onLogout}
            className="p-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-red-400 transition-colors"
            title="Cerrar sesión"
          >
            <LogOut className="w-4 h-4" />
          </button>
        </div>
      </div>

      {/* Navegación por Pestañas Horizontales */}
      <div className="bg-[#080D18] border-b border-slate-800/80 px-3 py-2 flex gap-1.5 overflow-x-auto sticky top-[63px] z-20">
        {navTabs.map((tab) => {
          const Icon = tab.icon;
          const isActive = activeTab === tab.id;
          return (
            <button
              key={tab.id}
              onClick={() => setActiveTab(tab.id)}
              className={`px-3 py-2 rounded-xl text-[11px] font-bold flex items-center gap-1.5 whitespace-nowrap transition-all ${
                isActive
                  ? 'bg-[#0088FF] text-white shadow-md shadow-[#0088FF]/25'
                  : 'bg-[#0F172A] text-slate-400 hover:text-slate-200 border border-slate-800/80'
              }`}
            >
              <Icon className="w-3.5 h-3.5" />
              {tab.label}
              {tab.id === 'orders' && stats.pendingOrders > 0 && (
                <span className="ml-0.5 px-1.5 py-0.2 rounded-full bg-amber-400 text-black text-[9px] font-black">
                  {stats.pendingOrders}
                </span>
              )}
            </button>
          );
        })}
      </div>

      {/* Contenido Dinámico de cada Sección */}
      <div className="p-4 space-y-4 flex-1">
        {/* 1. ESTADÍSTICAS BÁSICAS */}
        {activeTab === 'stats' && (
          <div className="space-y-4">
            <div className="grid grid-cols-2 gap-3">
              <div className="bg-[#0F172A] border border-slate-800 p-4 rounded-2xl">
                <div className="flex items-center justify-between text-slate-400 text-[11px]">
                  <span>Productos Activos</span>
                  <Package className="w-4 h-4 text-[#0088FF]" />
                </div>
                <p className="text-2xl font-black text-white mt-1.5">{stats.totalProducts}</p>
                <span className="text-[10px] text-emerald-400">{categories.length} categorías</span>
              </div>

              <div className="bg-[#0F172A] border border-slate-800 p-4 rounded-2xl">
                <div className="flex items-center justify-between text-slate-400 text-[11px]">
                  <span>Ingresos Totales</span>
                  <TrendingUp className="w-4 h-4 text-emerald-400" />
                </div>
                <p className="text-2xl font-black text-[#38BDF8] mt-1.5">${stats.totalRevenue.toFixed(2)}</p>
                <span className="text-[10px] text-slate-400">{stats.totalOrders} pedidos registrados</span>
              </div>

              <div className="bg-[#0F172A] border border-slate-800 p-4 rounded-2xl">
                <div className="flex items-center justify-between text-slate-400 text-[11px]">
                  <span>Pedidos Pendientes</span>
                  <Clock className="w-4 h-4 text-amber-400" />
                </div>
                <p className="text-2xl font-black text-amber-400 mt-1.5">{stats.pendingOrders}</p>
                <span className="text-[10px] text-slate-400">Requieren atención</span>
              </div>

              <div className="bg-[#0F172A] border border-slate-800 p-4 rounded-2xl">
                <div className="flex items-center justify-between text-slate-400 text-[11px]">
                  <span>Alertas Bajo Stock</span>
                  <AlertTriangle className="w-4 h-4 text-rose-400" />
                </div>
                <p className="text-2xl font-black text-rose-400 mt-1.5">{stats.lowStockCount}</p>
                <span className="text-[10px] text-slate-400">≤ 10 unidades</span>
              </div>
            </div>

            {/* Accesos Rápidos */}
            <div className="bg-[#0F172A] border border-slate-800 rounded-2xl p-4 space-y-2.5">
              <h3 className="text-xs font-bold uppercase tracking-wider text-slate-300">Acciones Rápidas</h3>
              <div className="grid grid-cols-2 gap-2">
                <button
                  onClick={() => {
                    setActiveTab('products');
                    openCreateProduct();
                  }}
                  className="p-3 rounded-xl bg-[#0088FF]/15 border border-[#0088FF]/40 text-[#38BDF8] text-xs font-bold flex items-center justify-center gap-1.5 hover:bg-[#0088FF] hover:text-white transition-colors"
                >
                  <Plus className="w-4 h-4" /> Nuevo Producto
                </button>
                <button
                  onClick={() => setActiveTab('marketing')}
                  className="p-3 rounded-xl bg-slate-800/80 border border-slate-700 text-slate-200 text-xs font-bold flex items-center justify-center gap-1.5 hover:border-[#38BDF8] transition-colors"
                >
                  <Megaphone className="w-4 h-4 text-[#38BDF8]" /> Crear Banner
                </button>
              </div>
            </div>

            {/* Últimos pedidos */}
            <div className="bg-[#0F172A] border border-slate-800 rounded-2xl p-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-xs font-bold uppercase tracking-wider text-slate-300">Actividad Reciente</h3>
                <button onClick={() => setActiveTab('orders')} className="text-[11px] text-[#38BDF8] font-semibold">
                  Ver todos →
                </button>
              </div>
              {orders.slice(0, 3).map((ord) => (
                <div key={ord.id} className="py-2.5 border-b border-slate-800/80 last:border-none flex items-center justify-between text-xs">
                  <div>
                    <p className="font-bold text-white">{ord.id} • {ord.customerName}</p>
                    <p className="text-[10px] text-slate-400">{ord.date}</p>
                  </div>
                  <div className="text-right">
                    <p className="font-bold text-[#38BDF8]">${ord.total.toFixed(2)}</p>
                    <span className="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-amber-300">{ord.status}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* 2. GESTIÓN DE PRODUCTOS (CRUD COMPLETO) */}
        {activeTab === 'products' && (
          <div className="space-y-3">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-sm font-extrabold text-white">Catálogo ({products.length})</h3>
                <p className="text-[11px] text-slate-400">Edita precios, fotos, stock y promociones</p>
              </div>
              <button
                onClick={openCreateProduct}
                className="bg-[#0088FF] hover:bg-[#0EA5E9] text-white text-xs font-bold px-3.5 py-2.5 rounded-xl flex items-center gap-1.5 shadow-lg shadow-[#0088FF]/25"
              >
                <Plus className="w-4 h-4" /> Agregar
              </button>
            </div>

            <div className="space-y-2.5">
              {products.map((prod) => (
                <div
                  key={prod.id}
                  className="bg-[#0F172A] border border-slate-800 rounded-2xl p-3 flex items-center gap-3"
                >
                  <img
                    src={prod.image}
                    alt={prod.name}
                    className="w-16 h-16 rounded-xl object-cover bg-black border border-slate-800 shrink-0"
                  />
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-1.5">
                      <span className="text-[9px] font-bold px-2 py-0.5 rounded-md bg-slate-800 text-[#38BDF8]">
                        {prod.category}
                      </span>
                      {prod.discountPercent > 0 && (
                        <span className="text-[9px] font-bold px-1.5 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300">
                          -{prod.discountPercent}%
                        </span>
                      )}
                    </div>
                    <h4 className="font-bold text-xs text-white truncate mt-1">{prod.name}</h4>
                    <div className="flex items-center gap-3 mt-1 text-[11px]">
                      <span className="font-extrabold text-[#38BDF8]">${prod.price.toFixed(2)}</span>
                      <span className={prod.stock > 0 ? 'text-slate-400' : 'text-rose-400 font-bold'}>
                        Stock: {prod.stock}
                      </span>
                    </div>
                  </div>
                  <div className="flex flex-col gap-1.5">
                    <button
                      onClick={() => openEditProduct(prod)}
                      className="p-2 rounded-xl bg-slate-800 hover:bg-[#0088FF] text-slate-300 hover:text-white transition-colors"
                      title="Editar producto"
                    >
                      <Edit3 className="w-3.5 h-3.5" />
                    </button>
                    <button
                      onClick={() => handleDeleteProduct(prod.id)}
                      className="p-2 rounded-xl bg-slate-800 hover:bg-rose-600 text-slate-300 hover:text-white transition-colors"
                      title="Eliminar producto"
                    >
                      <Trash2 className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* 3. GESTIÓN DE CATEGORÍAS (CRUD) */}
        {activeTab === 'categories' && (
          <div className="space-y-4">
            <form onSubmit={handleSaveCategory} className="bg-[#0F172A] border border-slate-800 rounded-2xl p-4 space-y-3">
              <h3 className="text-xs font-extrabold uppercase tracking-wider text-[#38BDF8]">
                {editingCatId ? 'Editar Categoría' : 'Nueva Categoría'}
              </h3>
              <input
                type="text"
                required
                value={newCatName}
                onChange={(e) => setNewCatName(e.target.value)}
                placeholder="Nombre de categoría (ej. Microcontroladores)"
                className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-xs text-white"
              />
              <input
                type="text"
                value={newCatDesc}
                onChange={(e) => setNewCatDesc(e.target.value)}
                placeholder="Descripción breve de la categoría"
                className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-xs text-white"
              />
              <div className="flex gap-2">
                <button
                  type="submit"
                  className="flex-1 bg-[#0088FF] hover:bg-[#0EA5E9] text-white font-bold py-2.5 rounded-xl text-xs"
                >
                  {editingCatId ? 'Actualizar Categoría' : 'Crear Categoría'}
                </button>
                {editingCatId && (
                  <button
                    type="button"
                    onClick={() => {
                      setEditingCatId(null);
                      setNewCatName('');
                      setNewCatDesc('');
                    }}
                    className="px-3 py-2.5 rounded-xl bg-slate-800 text-slate-300 text-xs font-bold"
                  >
                    Cancelar
                  </button>
                )}
              </div>
            </form>

            <div className="space-y-2">
              {categories.map((cat) => {
                const count = products.filter((p) => p.category === cat.name).length;
                return (
                  <div
                    key={cat.id}
                    className="bg-[#0F172A] border border-slate-800 rounded-2xl p-3 flex items-center justify-between gap-2"
                  >
                    <div className="min-w-0">
                      <h4 className="font-bold text-xs text-white flex items-center gap-2">
                        {cat.name}
                        <span className="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-[#38BDF8]">
                          {count} prod.
                        </span>
                      </h4>
                      <p className="text-[11px] text-slate-400 truncate mt-0.5">{cat.description}</p>
                    </div>
                    <div className="flex gap-1.5 shrink-0">
                      <button
                        onClick={() => {
                          setEditingCatId(cat.id);
                          setNewCatName(cat.name);
                          setNewCatDesc(cat.description);
                        }}
                        className="p-2 rounded-xl bg-slate-800 text-slate-300 hover:text-[#38BDF8]"
                      >
                        <Edit3 className="w-3.5 h-3.5" />
                      </button>
                      <button
                        onClick={() => handleDeleteCategory(cat)}
                        className="p-2 rounded-xl bg-slate-800 text-slate-300 hover:text-rose-400"
                      >
                        <Trash2 className="w-3.5 h-3.5" />
                      </button>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* 4. PROMOCIONES, BANNERS Y ANUNCIOS */}
        {activeTab === 'marketing' && (
          <div className="space-y-5">
            {/* Publicar Anuncio Superior */}
            <form onSubmit={handleCreateAnnouncement} className="bg-[#0F172A] border border-slate-800 rounded-2xl p-4 space-y-2.5">
              <h3 className="text-xs font-extrabold uppercase tracking-wider text-[#38BDF8] flex items-center gap-1.5">
                <Bell className="w-4 h-4" /> Publicar Anuncio Superior
              </h3>
              <input
                type="text"
                required
                value={newAnnouncementText}
                onChange={(e) => setNewAnnouncementText(e.target.value)}
                placeholder="Ej. 🚀 Envíos gratis en compras mayores a $50"
                className="w-full bg-[#05080F] border border-slate-700 rounded-xl p-2.5 text-xs text-white"
              />
              <button type="submit" className="w-full bg-[#0088FF] text-white font-bold py-2.5 rounded-xl text-xs">
                Publicar Anuncio
              </button>

              <div className="pt-2 space-y-1.5">
                {announcements.map((ann) => (
