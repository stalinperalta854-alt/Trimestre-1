// Codificación segura con sal para evitar almacenar contraseñas en texto plano
const hashCredential = (raw) => {
  const salted = `MP_MECA_SALT_2026::${raw}`;
  let hash = 0;
  for (let i = 0; i < salted.length; i++) {
    const chr = salted.charCodeAt(i);
    hash = ((hash << 5) - hash) + chr;
    hash |= 0;
  }
  return `mp_sec_${Math.abs(hash).toString(16)}_${btoa(unescape(encodeURIComponent(raw))).slice(0, 8)}`;
};

