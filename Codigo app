                    {ord.items.map((i) => `${i.quantity}x ${i.name}`).join(', ')}
                  </p>
                  <div className="flex justify-between text-[10px] text-slate-400 pt-1">
                    <span>{ord.date}</span>
                    <span className="font-bold text-white">Total: ${ord.total.toFixed(2)}</span>
                  </div>
                </div>
              ))
            )}
          </div>

          {/* Favoritos Guardados */}
          <div className="bg-[#0F172A] border border-slate-800 rounded-2xl p-4 space-y-2.5">
            <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-300 flex items-center gap-1.5">
              <Heart className="w-4 h-4 text-rose-400" /> Mis Favoritos ({favorites.length})
            </h3>
            {favorites.length === 0 ? (
              <p className="text-xs text-slate-500">Guarda componentes con el ícono de corazón.</p>
            ) : (
              <div className="space-y-2">
                {products
                  .filter((p) => favorites.includes(p.id))
                  .map((fav) => (
                    <div
                      key={fav.id}
                      onClick={() => openProductDetail(fav)}
                      className="flex items-center justify-between p-2.5 rounded-xl bg-[#05080F] border border-slate-800 cursor-pointer hover:border-[#0088FF]"
                    >
                      <span className="text-xs font-semibold text-white truncate pr-2">{fav.name}</span>
                      <span className="text-xs font-bold text-[#38BDF8]">${getFinalPrice(fav).toFixed(2)}</span>
                    </div>
                  ))}
              </div>
            )}
          </div>

          {/* Módulos Preparados para Futuras Actualizaciones */}
          <div className="bg-[#0F172A] border border-slate-800 rounded-2xl p-4 space-y-2.5">
            <h3 className="text-xs font-extrabold uppercase tracking-wider text-slate-300">
              Ecosistema MP (Módulos Escalables)
            </h3>
            <div className="grid grid-cols-2 gap-2 text-[11px]">
              {[
                { label: 'Cupones MP', icon: Ticket },
                { label: 'Métodos de Pago', icon: CreditCard },
                { label: 'Soporte Técnico', icon: MessageSquare },
                { label: 'Puntos de Retiro', icon: MapPin },
              ].map((mod, i) => {
                const Icon = mod.icon;
                return (
                  <button
                    key={i}
                    onClick={() => showToast(`Módulo "${mod.label}" listo para integración API.`, 'info')}
                    className="p-2.5 rounded-xl bg-[#05080F] border border-slate-800 hover:border-[#0088FF]/50 flex items-center gap-2 text-slate-300 font-semibold"
                  >
                    <Icon className="w-3.5 h-3.5 text-[#0088FF]" />
                    <span>{mod.label}</span>
                  </button>
                );
              })}
            </div>
          </div>

          <button
            onClick={onSwitchRole}
            className="w-full py-3 rounded-2xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white text-xs font-bold"
          >
            Volver a Selección de Usuario
          </button>
        </div>
      )}

      {/* ==================================================================== */}
      {/* BARRA DE NAVEGACIÓN INFERIOR FIJA: Inicio | Categorías | Carrito | Perfil */}
      {/* ==================================================================== */}
      <nav className="sticky bottom-0 left-0 right-0 z-40 bg-[#080D18]/95 backdrop-blur-md border-t border-slate-800/90 px-4 py-2.5 mt-auto">
        <div className="grid grid-cols-4 gap-1">
          {[
            { id: 'home', label: 'Inicio', icon: Home },
            { id: 'categories', label: 'Categorías', icon: Grid },
            { id: 'cart', label: 'Carrito', icon: ShoppingCart, badge: cartCount },
            { id: 'profile', label: 'Perfil', icon: User },
          ].map((nav) => {
            const Icon = nav.icon;
            const active = clientTab === nav.id;
            return (
              <button
                key={nav.id}
                onClick={() => {
                  setSelectedProduct(null);
                  setClientTab(nav.id);
                }}
                className={`relative flex flex-col items-center justify-center py-1.5 rounded-2xl transition-all ${
                  active
                    ? 'text-[#38BDF8] bg-[#0088FF]/15 font-extrabold'
                    : 'text-slate-400 hover:text-slate-200 font-medium'
                }`}
              >
                <div className="relative">
                  <Icon className="w-5 h-5" />
                  {nav.badge > 0 && (
                    <span className="absolute -top-1.5 -right-2.5 min-w-[18px] h-[18px] px-1 rounded-full bg-[#0088FF] text-white text-[10px] font-black flex items-center justify-center shadow">
                      {nav.badge}
                    </span>
                  )}
                </div>
                <span className="text-[10px] mt-1">{nav.label}</span>
              </button>
            );
          })}
        </div>
      </nav>
    </div>
  );
}
