                    <span className="text-[10px] text-slate-500">@{u.username}</span>
                  </div>
                  <h4 className="text-xs font-bold text-white truncate mt-1">{u.name}</h4>
                  <p className="text-[10px] text-slate-400 truncate">{u.email}</p>
                </div>

                {u.id !== admin.id && (
                  <button
                    onClick={() => {
                      setUsers((prev) =>
                        prev.map((item) => (item.id === u.id ? { ...item, active: !item.active } : item))
                      );
                      showToast(`Estado de ${u.name} actualizado.`, 'info');
                    }}
                    className={`px-3 py-1.5 rounded-xl text-[10px] font-bold shrink-0 ${
                      u.active
                        ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'
