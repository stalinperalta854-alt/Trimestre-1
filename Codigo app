export default function App() {
  // --- Persistencia Centralizada en localStorage ---
  const loadState = (key, fallback) => {
    try {
      const saved = localStorage.getItem(key);
      return saved ? JSON.parse(saved) : fallback;
    } catch {
      return fallback;
    }
  };

  const [categories, setCategories] = useState(() => loadState(STORAGE_KEYS.CATEGORIES, DEFAULT_CATEGORIES));
  const [products, setProducts] = useState(() => loadState(STORAGE_KEYS.PRODUCTS, DEFAULT_PRODUCTS));
  const [banners, setBanners] = useState(() => loadState(STORAGE_KEYS.BANNERS, DEFAULT_BANNERS));
  const [announcements, setAnnouncements] = useState(() => loadState(STORAGE_KEYS.ANNOUNCEMENTS, DEFAULT_ANNOUNCEMENTS));
  const [orders, setOrders] = useState(() => loadState(STORAGE_KEYS.ORDERS, DEFAULT_ORDERS));
  const [users, setUsers] = useState(() => loadState(STORAGE_KEYS.USERS, DEFAULT_USERS));
  const [cart, setCart] = useState(() => loadState(STORAGE_KEYS.CART, []));
  const [favorites, setFavorites] = useState(() => loadState(STORAGE_KEYS.FAVORITES, ['prod-1']));

  useEffect(() => { localStorage.setItem(STORAGE_KEYS.CATEGORIES, JSON.stringify(categories)); }, [categories]);
  useEffect(() => { localStorage.setItem(STORAGE_KEYS.PRODUCTS, JSON.stringify(products)); }, [products]);
  useEffect(() => { localStorage.setItem(STORAGE_KEYS.BANNERS, JSON.stringify(banners)); }, [banners]);
  useEffect(() => { localStorage.setItem(STORAGE_KEYS.ANNOUNCEMENTS, JSON.stringify(announcements)); }, [announcements]);
  useEffect(() => { localStorage.setItem(STORAGE_KEYS.ORDERS, JSON.stringify(orders)); }, [orders]);
  useEffect(() => { localStorage.setItem(STORAGE_KEYS.USERS, JSON.stringify(users)); }, [users]);
  useEffect(() => { localStorage.setItem(STORAGE_KEYS.CART, JSON.stringify(cart)); }, [cart]);
  useEffect(() => { localStorage.setItem(STORAGE_KEYS.FAVORITES, JSON.stringify(favorites)); }, [favorites]);

  // --- Navegación y Seguridad de Roles ---
  const [screen, setScreen] = useState('splash'); // splash | roleSelect | adminLogin | adminPanel | clientApp
  const [authenticatedAdmin, setAuthenticatedAdmin] = useState(null);
  const [clientTab, setClientTab] = useState('home'); // home | categories | cart | profile
  const [selectedProduct, setSelectedProduct] = useState(null);
  const [detailQty, setDetailQty] = useState(1);
  const [lastOrderReceipt, setLastOrderReceipt] = useState(null);

  // --- Notificación Toast Interna (Sin alert/confirm nativos) ---
  const [toast, setToast] = useState(null);
  const showToast = (message, type = 'info') => {
    setToast({ message, type });
    setTimeout(() => setToast(null), 3200);
  };

  // --- Transición automática desde Splash Screen (2.5 segundos) ---
  useEffect(() => {
    if (screen === 'splash') {
      const timer = setTimeout(() => {
        setScreen('roleSelect');
      }, 2500);
      return () => clearTimeout(timer);
    }
  }, [screen]);

  // Guardián de seguridad: impide acceder al panel admin sin sesión válida
  useEffect(() => {
    if (screen === 'adminPanel' && (!authenticatedAdmin || authenticatedAdmin.role !== 'admin')) {
      setScreen('adminLogin');
      showToast('Acceso restringido. Inicia sesión como Administrador.', 'error');
    }
  }, [screen, authenticatedAdmin]);

  // --- Cálculo de precios con promoción ---
  const getFinalPrice = (product) => {
    if (product.discountPercent && product.discountPercent > 0) {
      return Number((product.price * (1 - product.discountPercent / 100)).toFixed(2));
    }
    return Number(product.price.toFixed(2));
  };

  // --- Funciones del Carrito ---
  const addToCart = (product, qty = 1) => {
    if (product.stock <= 0) {
      showToast('Producto agotado actualmente.', 'error');
      return;
    }
    setCart((prev) => {
      const existing = prev.find((item) => item.id === product.id);
      if (existing) {
        const nextQty = Math.min(product.stock, existing.quantity + qty);
        if (nextQty === existing.quantity) {
          showToast(`Stock máximo alcanzado (${product.stock} uds).`, 'warning');
          return prev;
        }
        showToast(`Cantidad actualizada: ${product.name}`, 'success');
        return prev.map((item) => item.id === product.id ? { ...item, quantity: nextQty } : item);
      }
      const validQty = Math.min(product.stock, qty);
      showToast(`Agregado al carrito: ${product.name}`, 'success');
      return [...prev, { id: product.id, quantity: validQty }];
    });
  };

  const updateCartQty = (productId, delta) => {
    const prod = products.find((p) => p.id === productId);
    if (!prod) return;
    setCart((prev) =>
      prev
        .map((item) => {
          if (item.id !== productId) return item;
          const next = item.quantity + delta;
          if (next <= 0) return null;
          if (next > prod.stock) {
            showToast(`Solo hay ${prod.stock} unidades disponibles.`, 'warning');
            return item;
          }
          return { ...item, quantity: next };
        })
        .filter(Boolean)
    );
  };

  const removeFromCart = (productId) => {
    setCart((prev) => prev.filter((item) => item.id !== productId));
    showToast('Producto eliminado del carrito.', 'info');
  };

  const toggleFavorite = (productId) => {
    setFavorites((prev) =>
      prev.includes(productId) ? prev.filter((id) => id !== productId) : [...prev, productId]
    );
  };

  // ==========================================================================
  // RENDERIZADO DENTRO DE MARCO DE TELÉFONO MÓVIL MODERNO Y RESPONSIVO
  // ==========================================================================
  return (
    <div className="min-h-screen bg-[#020408] text-slate-100 flex items-center justify-center p-0 sm:p-4 md:p-6 font-sans selection:bg-[#0088FF] selection:text-white">
      {/* Resplandor ambiental sutil en escritorio */}
      <div className="fixed inset-0 pointer-events-none overflow-hidden hidden sm:block">
        <div className="absolute -top-32 left-1/4 w-96 h-96 bg-[#0088FF]/10 rounded-full blur-[120px]" />
        <div className="absolute -bottom-32 right-1/4 w-96 h-96 bg-[#0EA5E9]/10 rounded-full blur-[120px]" />
      </div>

      {/* Marco del Dispositivo Móvil */}
      <div className="relative w-full sm:w-[420px] md:w-[440px] h-screen sm:h-[850px] sm:max-h-[92vh] bg-[#05080F] sm:rounded-[44px] sm:border-[6px] sm:border-[#1E293B] shadow-[0_0_60px_rgba(0,136,255,0.18)] flex flex-col overflow-hidden">
        {/* Notch superior decorativo en pantallas grandes */}
        <div className="hidden sm:flex items-center justify-between px-7 pt-2.5 pb-1.5 bg-[#05080F] text-[11px] font-medium text-slate-400 z-50 shrink-0">
          <span>MP•OS</span>
          <div className="w-24 h-4 bg-black rounded-full border border-slate-800/80 flex items-center justify-center">
            <div className="w-2 h-2 rounded-full bg-[#0088FF]/60 animate-pulse" />
          </div>
          <span className="text-[#0EA5E9] font-semibold">5G ⚡</span>
        </div>

        {/* Notificación Toast Flotante */}
        {toast && (
          <div className="absolute top-12 left-4 right-4 z-[60] animate-bounce">
            <div
              className={`px-4 py-3 rounded-2xl border backdrop-blur-md shadow-xl flex items-center gap-2.5 text-xs font-semibold ${
                toast.type === 'error'
                  ? 'bg-red-950/90 border-red-500/50 text-red-200'
                  : toast.type === 'warning'
                  ? 'bg-amber-950/90 border-amber-500/50 text-amber-200'
                  : 'bg-[#0F172A]/95 border-[#0088FF]/60 text-white'
              }`}
            >
              <Zap className="w-4 h-4 text-[#0088FF] shrink-0" />
              <span className="flex-1">{toast.message}</span>
            </div>
          </div>
        )}

        {/* Contenedor Principal de Pantallas */}
        <div className="flex-1 overflow-y-auto overflow-x-hidden relative scrollbar-thin scrollbar-thumb-slate-800">
          {screen === 'splash' && (
            <SplashScreen onSkip={() => setScreen('roleSelect')} />
          )}

          {screen === 'roleSelect' && (
            <RoleSelectionScreen
              onSelectAdmin={() => {
                if (authenticatedAdmin) {
                  setScreen('adminPanel');
                } else {
                  setScreen('adminLogin');
                }
              }}
              onSelectClient={() => {
                setSelectedProduct(null);
                setClientTab('home');
                setScreen('clientApp');
              }}
            />
          )}

          {screen === 'adminLogin' && (
            <AdminLoginScreen
              users={users}
              setUsers={setUsers}
              onBack={() => setScreen('roleSelect')}
              onSuccess={(adminUser) => {
                setAuthenticatedAdmin(adminUser);
                setScreen('adminPanel');
                showToast(`Bienvenido, ${adminUser.name}`, 'success');
              }}
              showToast={showToast}
            />
          )}

          {screen === 'adminPanel' && authenticatedAdmin && (
            <AdminDashboard
              admin={authenticatedAdmin}
              products={products}
              setProducts={setProducts}
              categories={categories}
              setCategories={setCategories}
              banners={banners}
              setBanners={setBanners}
              announcements={announcements}
              setAnnouncements={setAnnouncements}
              orders={orders}
              setOrders={setOrders}
              users={users}
              setUsers={setUsers}
              onLogout={() => {
                setAuthenticatedAdmin(null);
                setScreen('roleSelect');
                showToast('Sesión de administrador cerrada.', 'info');
              }}
              onPreviewStore={() => {
                setSelectedProduct(null);
                setClientTab('home');
                setScreen('clientApp');
              }}
              showToast={showToast}
            />
          )}

          {screen === 'clientApp' && (
            <ClientStorefront
              products={products}
              setProducts={setProducts}
              categories={categories}
              banners={banners}
              announcements={announcements}
              cart={cart}
              setCart={setCart}
              addToCart={addToCart}
              updateCartQty={updateCartQty}
              removeFromCart={removeFromCart}
              favorites={favorites}
              toggleFavorite={toggleFavorite}
              orders={orders}
              setOrders={setOrders}
              getFinalPrice={getFinalPrice}
              clientTab={clientTab}
              setClientTab={setClientTab}
              selectedProduct={selectedProduct}
              setSelectedProduct={setSelectedProduct}
              detailQty={detailQty}
              setDetailQty={setDetailQty}
              lastOrderReceipt={lastOrderReceipt}
              setLastOrderReceipt={setLastOrderReceipt}
              onSwitchRole={() => setScreen('roleSelect')}
              showToast={showToast}
            />
          )}
        </div>

        {/* Barra inferior decorativa estilo móvil */}
        <div className="hidden sm:flex justify-center py-1.5 bg-[#05080F] shrink-0">
          <div className="w-32 h-1 bg-slate-700/70 rounded-full" />
        </div>
      </div>
    </div>
  );
}

